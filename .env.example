# Connexion PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/selforder"

# Secret de signature des JWT (générer avec : openssl rand -hex 32)
JWT_SECRET="change-me"

# URL publique de l'application (utilisée pour les QR Codes)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optionnel : SMTP pour l'envoi des rapports par e-mail
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Rapports <rapports@monsite.com>"
