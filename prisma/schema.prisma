// Schéma de données — Plateforme SaaS de commande par QR Code
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SERVER
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum NotificationType {
  NEW_ORDER
  ORDER_CANCELLED
  PRODUCT_UNAVAILABLE
  REPORT_READY
  SYSTEM
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// ─────────────────────────────── Modèles ───────────────────────────────

model Restaurant {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  description  String?
  logoUrl      String?
  address      String?
  phone        String?
  email        String?
  currency     String           @default("EUR")
  defaultVat   Decimal          @default(10) @db.Decimal(5, 2)
  primaryColor String           @default("#E11D48")
  darkMode     Boolean          @default(false)
  openingHours Json? // { "monday": "11:30-22:30", ... }
  socials      Json? // { "instagram": "...", "facebook": "..." }

  status             RestaurantStatus @default(ACTIVE)
  plan               SubscriptionPlan @default(FREE)
  monthlyFee         Decimal          @default(0) @db.Decimal(10, 2)
  subscriptionEndsAt DateTime?

  orderCounter Int @default(0)

  users           User[]
  categories      Category[]
  products        Product[]
  tables          Table[]
  qrCodes         QrCode[]
  orders          Order[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  reports         Report[]
  reportSchedules ReportSchedule[]
  apiKeys         ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  name              String
  role              Role      @default(ADMIN)
  isActive          Boolean   @default(true)
  resetToken        String?   @unique
  resetTokenExpires DateTime?
  lastLoginAt       DateTime?

  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  notifications Notification[]
  activityLogs  ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, sortOrder])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  imageUrl        String?
  isAvailable     Boolean  @default(true)
  prepTimeMinutes Int      @default(10)
  allergens       String[] @default([])
  tags            String[] @default([]) // NOUVEAU, POPULAIRE, EPICE, VEGETARIEN, VEGAN, SANS_GLUTEN
  vatRate         Decimal  @default(10) @db.Decimal(5, 2)
  sortOrder       Int      @default(0)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  optionGroups OptionGroup[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([categoryId, sortOrder])
}

// Groupe d'options : choix uniques (pâte fine/classique) ou suppléments multiples payants
model OptionGroup {
  id         String  @id @default(cuid())
  name       String
  isRequired Boolean @default(false)
  minSelect  Int     @default(0)
  maxSelect  Int     @default(1) // > 1 ou 0 (illimité) = suppléments multiples
  sortOrder  Int     @default(0)

  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  choices   OptionChoice[]

  @@index([productId, sortOrder])
}

model OptionChoice {
  id          String  @id @default(cuid())
  name        String
  priceDelta  Decimal @default(0) @db.Decimal(10, 2)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  groupId String
  group   OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

model Table {
  id   String  @id @default(cuid())
  name String // "Table 1", "Terrasse 3"…
  zone String? // Salle, Terrasse, Étage…

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrCodes      QrCode[]
  orders       Order[]

  createdAt DateTime @default(now())

  @@index([restaurantId])
}

model QrCode {
  id    String  @id @default(cuid())
  label String // "Salle", "Terrasse", "Table 4"…
  scans Int     @default(0)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String?
  table        Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([restaurantId])
}

model Order {
  id           String      @id @default(cuid())
  number       Int // séquence par restaurant
  customerName String?
  type         OrderType   @default(DINE_IN)
  status       OrderStatus @default(NEW)
  note         String?
  totalAmount  Decimal     @db.Decimal(10, 2)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String?
  table        Table?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableName    String? // snapshot

  items    OrderItem[]
  payments Payment[]

  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  productName String // snapshot au moment de la commande
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  totalPrice  Decimal @db.Decimal(10, 2)
  vatRate     Decimal @default(10) @db.Decimal(5, 2)
  options     Json? // [{ group, choice, priceDelta }]
  comment     String?

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// Prévu pour l'évolution paiement en ligne
model Payment {
  id          String        @id @default(cuid())
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod @default(CASH)
  status      PaymentStatus @default(PENDING)
  provider    String? // stripe, paypal…
  providerRef String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
}

model Notification {
  id     String           @id @default(cuid())
  type   NotificationType
  title  String
  body   String?
  isRead Boolean          @default(false)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([restaurantId, isRead, createdAt])
}

model ActivityLog {
  id       String  @id @default(cuid())
  action   String // "order.create", "product.update"…
  entity   String?
  entityId String?
  details  Json?
  ip       String?

  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
}

model ReportSchedule {
  id        String          @id @default(cuid())
  frequency ReportFrequency
  email     String
  enabled   Boolean         @default(true)
  lastRunAt DateTime?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([restaurantId])
}

model Report {
  id          String          @id @default(cuid())
  frequency   ReportFrequency
  periodStart DateTime
  periodEnd   DateTime
  data        Json // KPI sérialisés du rapport

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([restaurantId, createdAt])
}

// Clés d'API pour intégrations externes (Zapier, Make, Power BI, Google Sheets…)
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String // 8 premiers caractères, affichés à l'utilisateur
  keyHash    String    @unique
  lastUsedAt DateTime?

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([restaurantId])
}

// Paramètres globaux de la plateforme (super admin)
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
